    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "pods": "cd ios && bundle exec pod install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.87.1",
    "aes-js": "^3.1.2",
    "js-sha512": "^0.9.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.ktmconnect.specs"
    }
